# PostHog product analytics (session replay, heatmaps, events).
# Find these under PostHog: Settings → Project → Project API Key.
# Both are safe to expose to the browser (NEXT_PUBLIC_*) — the project key is
# write-only and designed for client-side use.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Region host: US cloud is https://us.i.posthog.com (default),
# EU cloud is https://eu.i.posthog.com. Optional — omit to use the US default.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Web Analytics needs no env vars — enable it in the Vercel dashboard
# (Project → Analytics) and the <Analytics /> component does the rest.
